generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// A lista real de áreas vivia só no SERVICE_AREAS do frontend. Como enum,
// um valor inválido vira erro de compilação em vez de job que nunca casa.
enum ServiceArea {
  BARBEARIA
  CABELEIREIRO
  MANICURE_PEDICURE
  ESTETICA_FACIAL
  ESTETICA_CORPORAL
  DEPILACAO
  MAQUIAGEM
  DESIGN_SOBRANCELHAS
  MASSOTERAPIA
  FISIOTERAPIA
  PERSONAL_TRAINER
  NUTRICAO
  PSICOLOGIA
  ODONTOLOGIA
  PODOLOGIA
  TATUAGEM
}

enum JobStatus {
  OPEN // sem profissional confirmado
  PENDING // convite enviado a um profissional específico
  ACCEPTED
  CANCELLED
  COMPLETED
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

enum RequestOrigin {
  CLIENT_INVITE
  PROFESSIONAL_APPLICATION
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  phone     String
  birthDate DateTime @db.Date
  cpf       String   @unique

  zipCode      String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String

  clientProfile       ClientProfile?
  professionalProfile ProfessionalProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zipCode])
}

model ClientProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobs Job[]

  createdAt DateTime @default(now())
}

model ProfessionalProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  area        ServiceArea
  description String?

  requests JobRequest[]

  createdAt DateTime @default(now())

  @@index([area])
}

model Job {
  id          String      @id @default(cuid())
  area        ServiceArea
  title       String
  description String
  price       Decimal     @db.Decimal(10, 2)
  status      JobStatus   @default(OPEN)

  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clientId String

  requests JobRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status, area])
}

model JobRequest {
  id          String        @id @default(cuid())
  status      RequestStatus @default(PENDING)
  origin      RequestOrigin @default(PROFESSIONAL_APPLICATION)
  price       Decimal       @db.Decimal(10, 2)
  description String

  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId String

  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  professionalId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, professionalId])
  @@index([professionalId])
}
