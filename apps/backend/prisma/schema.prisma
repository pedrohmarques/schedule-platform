// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String
  phone    String
  age      Int
  cpf      String @unique

  zipCode      String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String

  job Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zipCode])
}

model Profissional {
  id          String  @id @default(cuid())
  name        String
  email       String  @unique
  password    String
  phone       String
  age         Int
  cpf         String  @unique
  area        String 
  description String?

  job JobRequest[]

  zipCode      String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zipCode])
}

enum JobStatus {
  OPEN // sem profissional confirmado, disponível pra qualquer um solicitar
  PENDING // convite enviado a um profissional específico, aguardando resposta
  ACCEPTED // profissional confirmado pro job
  CANCELLED
  COMPLETED
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

enum RequestOrigin {
  CLIENT_INVITE // job criado já endereçado a esse profissional; ele responde
  PROFESSIONAL_APPLICATION // profissional se candidatou a um job OPEN
}

model Job {
  id          String    @id @default(cuid())
  area        String
  title       String
  description String
  price       Decimal
  status      JobStatus @default(OPEN)

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  requests JobRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobRequest {
  id     String        @id @default(cuid())
  status RequestStatus @default(PENDING)
  origin RequestOrigin @default(PROFESSIONAL_APPLICATION)
  price  Decimal
  description String

  job   Job    @relation(fields: [jobId], references: [id])
  jobId String

  professional   Profissional @relation(fields: [professionalId], references: [id])
  professionalId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, professionalId]) // impede o mesmo profissional solicitar o mesmo job 2x
}
